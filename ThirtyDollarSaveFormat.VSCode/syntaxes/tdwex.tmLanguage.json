{
  "scopeName": "source.tdw",
  "name": "Thirty Dollar Save Format (TDW)",
  "patterns": [
    {
      "name": "comment.block.tdw",
      "begin": "(#\\s)(?!define|enddefine|icut|bookmark)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.comment.tdw" }
      },
      "end": "(?=\\|)",
      "patterns": [
        {
          "match": "[^|]+",
          "name": "comment.block.content.tdw"
        }
      ]
    },
    {
      "name": "meta.define.tdw",
      "begin": "(\\|?#define\\(([^)]*)\\)\\|?)",
      "beginCaptures": {
        "1": { "name": "keyword.control.define.tdw" },
        "2": { "name": "entity.name.function.define.tdw" }
      },
      "end": "(\\|?#enddefine\\|?)",
      "endCaptures": {
        "1": { "name": "keyword.control.define-end.tdw" }
      },
      "patterns": [
        {
          "include": "#main"
        }
      ]
    },
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "match": "\\|",
          "name": "punctuation.separator.tdw"
        },
        {
          "comment": "Legacy individual cut: #icut(sound, sound). Flips the file to the legacy format.",
          "begin": "(#icut)(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.custom.tdwex" },
            "2": { "name": "punctuation.section.arguments.begin.tdw" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.section.arguments.end.tdw" }
          },
          "patterns": [
            {
              "match": ",",
              "name": "punctuation.separator.cut.tdw"
            },
            {
              "match": "[^,)]+",
              "name": "entity.name.function.sound.cut.tdw"
            }
          ]
        },
        {
          "comment": "#bookmark(N) - jump label for the visualizer.",
          "match": "(#bookmark)(\\()([^)]*)(\\))",
          "captures": {
            "1": { "name": "keyword.control.custom.tdwex" },
            "2": { "name": "punctuation.section.arguments.begin.tdw" },
            "3": { "name": "constant.numeric.bookmark.tdw" },
            "4": { "name": "punctuation.section.arguments.end.tdw" }
          }
        },
        {
          "match": "#legacy|#enddefine",
          "name": "keyword.control.custom.tdwex"
        },
        {
          "match": "#[^|]+",
          "name": "comment.line.tdw"
        },
        {
          "comment": "Individual cut: !cut@sound or !cut@sound,sound. Bare !cut falls through to the action rule.",
          "match": "(!cut)(@)([^|]+)",
          "captures": {
            "1": { "name": "keyword.control.tdw" },
            "2": { "name": "keyword.operator.cut.tdw" },
            "3": {
              "patterns": [
                {
                  "match": ",",
                  "name": "punctuation.separator.cut.tdw"
                },
                {
                  "match": "[^,]+",
                  "name": "entity.name.function.sound.cut.tdw"
                }
              ]
            }
          }
        },
        {
          "comment": "!bg@#RRGGBB[AA],fadeSeconds - packed colour event.",
          "match": "(!bg)(@)(#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?)(,)([-0-9.]+)?",
          "captures": {
            "1": { "name": "keyword.control.tdw" },
            "2": { "name": "keyword.operator.value.tdw" },
            "3": { "name": "constant.other.color.rgb-value.tdw" },
            "4": { "name": "punctuation.separator.tdw" },
            "5": { "name": "constant.numeric.tdw" }
          }
        },
        {
          "comment": "!pulse@count,frequency",
          "match": "(!pulse)(@)([-0-9.]+)(,)([-0-9.]+)?",
          "captures": {
            "1": { "name": "keyword.control.tdw" },
            "2": { "name": "keyword.operator.value.tdw" },
            "3": { "name": "constant.numeric.tdw" },
            "4": { "name": "punctuation.separator.tdw" },
            "5": { "name": "constant.numeric.tdw" }
          }
        },
        {
          "comment": "Action events. Modifiers (@value, =repeats, ...) are matched by #modifiers below.",
          "match": "!(loopmany|looptarget|loop|startpos|stop|speed|highspeed|transpose|target|volume|combine|divider|flash|jump|cut|bg|pulse)\\b",
          "name": "keyword.control.tdw"
        },
        {
          "match": "!(?![a-z])|![a-z]+",
          "name": "invalid.illegal.unknown-action.tdw"
        },
        {
          "match": "_pause\\b",
          "name": "variable.language.pause.tdw"
        },
        {
          "include": "#modifiers"
        },
        {
          "comment": "Sound name: everything from the start of a token up to the first modifier, mirroring the parser's ^[^@%^=>]* regex.",
          "match": "(?:^|(?<=\\|))[ \\t]*([^|@%^=>!#\\s](?:[^|@%^=>\\n]*[^|@%^=>\\s])?)",
          "captures": {
            "1": { "name": "entity.name.function.sound.tdw" }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "comment": "@value with an optional @x / @+ / @/ scale suffix.",
          "match": "(@)([-0-9.]+)(?:(@)([+x/]))?",
          "captures": {
            "1": { "name": "keyword.operator.pitch.tdw" },
            "2": { "name": "constant.numeric.pitch.tdw" },
            "3": { "name": "keyword.operator.scale.tdw" },
            "4": { "name": "keyword.operator.scale.tdw" }
          }
        },
        {
          "match": "(%)([-0-9.]+)",
          "captures": {
            "1": { "name": "keyword.operator.volume.tdw" },
            "2": { "name": "constant.numeric.volume.tdw" }
          }
        },
        {
          "match": "(\\^)([-0-9.]+)",
          "captures": {
            "1": { "name": "keyword.operator.pan.tdw" },
            "2": { "name": "constant.numeric.pan.tdw" }
          }
        },
        {
          "comment": "Sound start offset in seconds, e.g. >0.25.",
          "match": "(>)([-0-9.]+)",
          "captures": {
            "1": { "name": "keyword.operator.offset.tdw" },
            "2": { "name": "constant.numeric.offset.tdw" }
          }
        },
        {
          "match": "(=)([0-9]+)",
          "captures": {
            "1": { "name": "keyword.operator.repeat.tdw" },
            "2": { "name": "constant.numeric.repeat.tdw" }
          }
        }
      ]
    }
  }
}
