{
    "comments": {
      "lineComment": "#"
    },
    "brackets": [
      ["[", "]"],
      ["(", ")"],
      ["{", "}"]
    ],
    "autoClosingPairs": [
      { "open": "[", "close": "]" },
      { "open": "(", "close": ")" },
      { "open": "{", "close": "}" },
      { "open": "\"", "close": "\"" }
    ],
    "surroundingPairs": [
      ["[", "]"],
      ["(", ")"],
      ["{", "}"],
      ["\"", "\""]
    ],
    "folding": {
      "markers": {
        "start": "#define\\(",
        "end": "#enddefine"
      }
    },
    "wordPattern": "[^|@%^=>\\s]+"
  }
  