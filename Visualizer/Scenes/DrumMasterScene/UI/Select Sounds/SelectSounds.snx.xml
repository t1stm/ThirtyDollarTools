<sundex version="2.0" context="DrumMasterScene.DrumMaster">
  <style language="sundex" src="UI/Select Sounds/SelectSounds.snx.ss"/>

  <layout>
    <panel id="main-holder">
      <panel id="background-holder">
        <panel class="background-gradients" id="grad-1"/>
        <panel class="background-gradients" id="grad-2"/>
        <panel class="background-gradients" id="grad-3"/>
        <panel class="background-gradients" id="grad-4"/>
        <panel class="background-gradients" id="grad-5"/>
      </panel>

      <flex id="main-view">
        <flex id="top-bar">
          <label id="title" value="Drum Master"/>
          <panel class="spacer"/>
          <button id="add-lane-button" on.click="{Context.AddLane}">
            <label value="Add Lane"/>
          </button>
        </flex>

        <flex id="content-area">
          <flex id="taiko-lane-list" ref="Context.LaneList">
            <!-- DrumMaster.AddLane puts a TaikoLaneConfiguration here per lane. -->
          </flex>

          <!-- DrumMaster puts its SoundList (#available-sounds) here: it needs the atlas store. -->
          <region ref="Context.SoundListSlot"/>
        </flex>

        <flex id="footer">
          <button id="back-button" on.click='{() => Context.SceneManager.TransitionTo("home")}'>
            <label value="Back"/>
          </button>

          <flex id="footer-buttons">
            <button id="speed-influences">
              <label value="!speed Influences Scroll Speed"/>
            </button>
            <button id="play-button" on.click="{Context.StartPlayback}">
              <label value="Start Drumming!"/>
            </button>
          </flex>
        </flex>
      </flex>
    </panel>
  </layout>
</sundex>
