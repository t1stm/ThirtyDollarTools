id grad-1 {
    background = !gradient {
        type = "radial";
        direction = !direction outward;
        stops = !stops [
            0% = "#7aa2f733", // AccentBlue 20%
            30% = "#4c78a820", // BlueDark 12%
            100% = "#00000000"
        ];
    };
    x = 15%;
    y = 20%;
    width = 800px;
    height = 800px;
    anchor-x = "center";
    anchor-y = "center";
}

