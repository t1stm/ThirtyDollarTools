<sundex version="1.0">
  <style language="sundex" src="Scenes/Layout/LoaderInterface.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/LoaderInterface.snx.csx" imports="[LoadingScene.Scenes]"/>

  <layout>
    <panel id="main-holder">
      <panel id="background-holder">
        <panel class="background-gradients" id="grad-1"/>
        <panel class="background-gradients" id="grad-2"/>
        <panel class="background-gradients" id="grad-3"/>
        <panel class="background-gradients" id="grad-4"/>
        <panel class="background-gradients" id="grad-5"/>
      </panel>

      <flex id="main-view">
        <label id="loader-title" value="Thirty Dollar Visualizer"/>
        <label id="loader-label" value="Ready to load"/>
        <progress id="loader-progress" percentage="0"/>

        <button id="start-button">
          <label value="Start Loading"/>
        </button>
      </flex>
    </panel>
  </layout>
</sundex>