<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Converter\ThirtyDollarConverter\ThirtyDollarConverter.csproj"/>
    <PackageReference Include="Sundex.Markup" Version="$(SundexVersion)"/>
    <PackageReference Include="Sundex.Components" Version="$(SundexVersion)"/>
    <PackageReference Include="Sundex.Engine" Version="$(SundexVersion)"/>
    <ProjectReference Include="..\HomeScene\HomeScene.csproj"/>
    <ProjectReference Include="..\..\Shared\Shared.csproj"/>
    <ProjectReference Include="..\VisualizerScene\VisualizerScene.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Scenes\Layout\LoaderInterface.snx.sml"/>
    <EmbeddedResource Include="Scenes\Layout\LoaderInterface.snx.xml"/>
    <None Remove="Scenes\Layout\LoaderInterface.snx.csx"/>
    <EmbeddedResource Include="Scenes\Layout\LoaderInterface.snx.csx"/>
    <!-- The loader itself no longer imports these; the settings and drum-master sheets do,
         by path, so they have to keep being embedded here. -->
    <None Remove="Scenes\Layout\LoaderGradients.snx.ss"/>
    <EmbeddedResource Include="Scenes\Layout\LoaderGradients.snx.ss"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Scenes\Layout\LoaderInterface.snx.ss"/>
    <EmbeddedResource Include="Scenes\Layout\LoaderInterface.snx.ss"/>
  </ItemGroup>

</Project>
