<sundex version="1.0">
  <style language="sundex" src="Scenes/Layout/HomeInterface.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/HomeInterface.snx.csx" imports="[HomeScene.Scenes]"/>

  <!-- The three tools are one continuous row split by hairlines, the way a Thirty Dollar
       sequence is one row of steps - not three floating cards. `page` covers the whole
       stage, so everything meant to sit on top of it (footer, settings) comes after it:
       ties in hit-testing go to the later sibling. -->
  <layout>
    <panel id="stage">
      <flex id="page">
        <flex id="masthead">
          <label id="eyebrow" value="T H I R T Y   D O L L A R"/>
          <label id="wordmark" value="VISUALIZER"/>
        </flex>

        <panel id="band">
          <panel id="cell-visualizer" class="cell">
            <flex id="steps-visualizer" class="steps"/>
            <label class="cell-title" value="Visualizer"/>
            <label class="cell-desc" value="Play a cover back with no dropped notes."/>
          </panel>

          <panel id="cell-drum-master" class="cell">
            <flex id="steps-drum-master" class="steps"/>
            <label class="cell-title" value="Drum Master"/>
            <label class="cell-desc" value="Play a loaded sequence live on taiko lanes."/>
          </panel>

          <panel id="cell-editor" class="cell">
            <flex id="steps-editor" class="steps"/>
            <label class="cell-title" value="Editor"/>
            <label class="cell-desc" value="Build a cover track by track and export it."/>
          </panel>

          <panel class="divider" id="divider-left"/>
          <panel class="divider" id="divider-right"/>

          <panel id="playhead">
            <panel id="playhead-line"/>
          </panel>
        </panel>
      </flex>

      <!-- Both values are the defaults for a build that isn't checking for updates; Home
           overwrites them once it knows the version and what the check found. -->
      <flex id="footer">
        <label id="version-label" value="Developer Build"/>
        <label id="update-label" value="Check for updates at github.com/t1stm/ThirtyDollarTools"/>
      </flex>

      <flex id="topbar">
        <button id="settings-button">
          <label value="Settings"/>
        </button>
      </flex>
    </panel>
  </layout>
</sundex>
