<sundex version="1.0">
  <style language="sundex">
    import "Scenes/Layout/HomeInterface.snx.ss";
  </style>
  
  <logic src="Scenes/Layout/HomeInterface.snx.csx" language="csharp" imports="[HomeScene.Scenes]" />

  <layout>
    <panel id="main-holder">
      <panel id="background-holder">
        <panel class="background-gradients" id="grad-1"/>
        <panel class="background-gradients" id="grad-2"/>
        <panel class="background-gradients" id="grad-3"/>
        <panel class="background-gradients" id="grad-4"/>
        <panel class="background-gradients" id="grad-5"/>
      </panel>

      <flex id="home-view">
        <label id="home-title" value="Thirty Dollar Visualizer"/>
        <panel id="spacer"/>
        
        <button id="visualizer-button" class="menu-button">
          <label value="Visualizer"/>
        </button>

        <button id="drum-master-button" class="menu-button">
          <label value="Important Button"/>
        </button>

        <button id="editor-button" class="menu-button">
          <label value="This One Is Not So Important"/>
        </button>

        <button id="settings-button" class="menu-button">
          <label value="Settings"/>
        </button>
      </flex>
    </panel>
  </layout>
</sundex>
