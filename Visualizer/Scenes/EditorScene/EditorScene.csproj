<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sundex\Sundex.Engine\Sundex.Engine.csproj"/>
    <ProjectReference Include="..\..\..\Sundex\Sundex.Markup\Sundex.Markup.csproj"/>
    <ProjectReference Include="..\..\..\Sundex\Sundex.Components\Sundex.Components.csproj"/>
    <ProjectReference Include="..\..\Shared\Shared.csproj"/>
    <ProjectReference Include="..\VisualizerScene\VisualizerScene.csproj"/>
    <ProjectReference Include="..\..\..\Converter\ThirtyDollarConverter.Editor\ThirtyDollarConverter.Editor.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scenes\**\*.snx.xml"/>
    <EmbeddedResource Include="Scenes\**\*.snx.csx"/>
    <!-- Globs, not per-file entries: a missing line is not a build error, the asset load
         just returns nothing and the component fails at runtime. The shared style
         vocabulary lives in Scenes\Styles, component-specific rules next to the markup
         they style. -->
    <EmbeddedResource Include="Scenes\**\*.snx.ss"/>
  </ItemGroup>

</Project>
