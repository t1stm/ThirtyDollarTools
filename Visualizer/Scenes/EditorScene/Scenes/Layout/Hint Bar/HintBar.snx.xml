<sundex version="1.0" component="hint-bar">
  <style language="sundex" src="Scenes/Layout/Hint Bar/HintBar.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/Hint Bar/HintBar.snx.csx" imports="[EditorScene.Scenes]"/>

  <layout>
    <flex id="hint-bar">
      <panel id="hint-gutter"/>
      <!-- One label per line the hint needs; EditorInterface.LayoutHint adds the rest
           and blanks the ones a shorter hint doesn't use. -->
      <flex id="hint-lines">
        <label id="hint-label" class="hint-line" value=""/>
      </flex>
    </flex>
  </layout>
</sundex>
