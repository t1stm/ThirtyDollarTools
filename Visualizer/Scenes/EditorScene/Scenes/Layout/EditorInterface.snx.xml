<sundex version="1.0">
  <style language="sundex" src="Scenes/Layout/EditorInterface.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/EditorInterface.snx.csx" imports="[EditorScene.Scenes]"/>

  <layout>
    <panel id="main-holder">
      <flex id="editor-header">
        <label id="editor-title" value="Editor"/>
        <label id="project-name" value="Untitled Project"/>
        <label id="project-bpm" value=""/>

        <panel class="header-divider"/>

        <label id="load-button" value="Load"/>
        <label id="save-button" value="Save"/>
        <label id="export-button" value="Export"/>
      </flex>

      <panel id="track-column"/>

      <flex id="grid-area"/>

      <panel id="inspector-column"/>

      <flex id="bottom-bar">
        <button id="back-button">
          <label value="Back"/>
        </button>

        <panel class="header-divider"/>

        <button id="play-button">
          <label value="Play"/>
        </button>
        <button id="stop-button">
          <label value="Stop"/>
        </button>
        <progress id="transport-progress"/>
        <label id="transport-time" value=""/>
      </flex>
    </panel>
  </layout>
</sundex>
