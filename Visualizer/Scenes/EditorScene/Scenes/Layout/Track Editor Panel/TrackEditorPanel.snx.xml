<sundex version="1.0" component="track-editor-panel">
  <style language="sundex" src="Scenes/Layout/Track Editor Panel/TrackEditorPanel.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/Track Editor Panel/TrackEditorPanel.snx.csx" imports="[EditorScene, EditorScene.Scenes]"/>

  <layout>
    <flex id="track-editor-panel" class="grid-panel">
      <flex class="tool-bar">
        <button id="back-to-arrangement">
          <label value="← Arrangement"/>
        </button>
        <text-input id="opened-track-name"/>
        <button id="instrument-button">
          <label value="Instrument: -"/>
        </button>
        <!-- No spacer: the name field is the percent-width child, so it soaks up the
             free space itself and the tool buttons still land flush right. A spacer
             beside it would take a second 100% share of the same free space (FlexPanel
             doesn't normalise percentages) and push the tools off the bar. -->
        <button id="editor-tool-draw" class="tool-button">
          <label class="tool-label" value="Draw"/>
        </button>
        <button id="editor-tool-select" class="tool-button">
          <label class="tool-label" value="Select"/>
        </button>
      </flex>
      <track-editor-view class="grid-view"/>
    </flex>
  </layout>
</sundex>
