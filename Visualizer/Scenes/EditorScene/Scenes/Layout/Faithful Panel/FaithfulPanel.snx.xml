<sundex version="1.0" component="faithful-panel">
  <style language="sundex" src="Scenes/Layout/Faithful Panel/FaithfulPanel.snx.ss"/>
  <logic language="csharp" src="Scenes/Layout/Faithful Panel/FaithfulPanel.snx.csx" imports="[EditorScene, EditorScene.Scenes, EditorScene.State]"/>

  <layout>
    <flex id="faithful-panel" class="grid-panel">
      <!-- Same bar as the note editor's, minus its instrument button: the palette is the
           instrument list. -->
      <flex class="tool-bar">
        <button id="back-to-arrangement">
          <label value="← Arrangement"/>
        </button>
        <text-input id="opened-track-name"/>
      </flex>
      <flex id="faithful-body" class="faithful-body">
        <faithful-palette/>
        <!-- The palette builds its own two boxes; the sequence's is here because its
             scroller is a registered element, not something the palette owns. -->
        <flex class="[faithful-section,faithful-section-sequence]">
          <flex class="faithful-section-bar">
            <label class="sound-section-header" value="Sequence"/>
            <panel class="spacer"/>
            <button id="faithful-follow" class="faithful-follow-button">
              <label class="follow-label" value="Follow scroll"/>
            </button>
          </flex>
          <faithful-sequence/>
        </flex>
      </flex>
    </flex>
  </layout>
</sundex>
