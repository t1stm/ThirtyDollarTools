<sundex version="1.0">
  <style language="sundex" src="Scenes/Dialogs/Dialogs.snx.ss"/>

  <layout>
    <flex id="confirm-dialog" class="dialog-frame">
      <!-- The question is the title, what it does the message; both, and the confirm button's
           label and fill class, are caller arguments applied by ConfirmDialog.cs. -->
      <flex class="dialog-header">
        <!-- Clipped before the ×: the question can carry a long name. -->
        <flex class="dialog-title-clip">
          <clipped-label id="title-label" class="dialog-title"/>
        </flex>
        <button id="close-button" class="icon-button">
          <label class="icon-button-icon" font="Lucide" value="&#xe1b2;"/>
        </button>
      </flex>
      <label id="message-label" class="[body-label,confirm-message]" value=""/>
      <flex class="dialog-actions">
        <button id="cancel-button" class="dialog-button">
          <label value="Cancel"/>
        </button>
        <button id="confirm-button">
          <label class="dark-label" value=""/>
        </button>
      </flex>
    </flex>
  </layout>
</sundex>
