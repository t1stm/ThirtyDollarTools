<sundex version="1.0">
  <style language="sundex" src="Scenes/Dialogs/Dialogs.snx.ss"/>

  <layout>
    <flex id="import-dialog" class="dialog-frame">
      <!-- Title text carries the dropped file's name, set by ImportDialog.cs. -->
      <label id="title-label" class="title-label" value=""/>

      <!-- The two options are color-coded with the same accents the Draw/Select tool
           toggles use elsewhere - not because import relates to either tool, but so the
           dialog reuses the app's two existing accent colors instead of introducing a
           third just to tell the options apart. See dialog-button-primary/-alt. -->
      <flex class="dialog-options">
        <flex class="dialog-column">
          <!-- Faithful is the suggested shape: it keeps the sequence exactly as written,
               where the piano roll has to fit it onto a bar/beat grid. So it gets the
               filled button and the piano roll sits under it as a bare label. -->
          <button id="faithful-track-button" class="[dialog-button-primary,dialog-button-tall]">
            <label value="Import as Faithful Track"/>
          </button>
          <button id="single-track-button" class="dialog-button-shape">
            <label class="caption-label" value="or as a Piano Roll track"/>
          </button>
          <!-- Label has no text-wrap support, so each description is pre-split into
               short lines that fit the column. -->
          <flex class="dialog-column-description">
            <label class="caption-label" value="One new track for this file,"/>
            <label class="caption-label" value="one instrument per sound."/>
          </flex>
        </flex>

        <panel class="dialog-divider"/>

        <flex class="dialog-column">
          <button id="project-button" class="[dialog-button-alt,dialog-button-tall]">
            <!-- Same light-background-needs-dark-text contrast rule as the Select toggle. -->
            <label class="dark-label" value="Import as Project"/>
          </button>
          <flex class="dialog-column-description">
            <label class="caption-label" value="Replaces the current project -"/>
            <label class="caption-label" value="instrument + track per sound."/>
          </flex>
        </flex>
      </flex>

      <flex class="dialog-actions-compact">
        <button id="cancel-button" class="dialog-button">
          <label value="Cancel"/>
        </button>
      </flex>
    </flex>
  </layout>
</sundex>
