<sundex version="1.0">
  <style language="sundex" src="Scenes/Dialogs/Dialogs.snx.ss"/>

  <layout>
    <flex id="import-dialog" class="dialog-frame">
      <flex class="dialog-header">
        <label class="dialog-title" value="Import"/>
        <!-- The dropped file's base name, set by ImportDialog.cs, and what it is. -->
        <label id="file-label" class="dialog-subtitle" value=""/>
        <flex class="info-chip">
          <label class="info-chip-label" value="TDW sequence"/>
        </flex>
        <panel class="spacer"/>
        <button id="close-button" class="icon-button">
          <label class="icon-button-icon" font="Lucide" value="&#xe1b2;"/>
        </button>
      </flex>

      <!-- Add Track's layout (TrackTypeDialog.snx.xml): the three ways in a list, and the
           picked one's card. -->
      <flex id="import-body" class="track-kind-body">
        <!-- ImportDialog.cs swaps track-kind-row-idle/-selected as one is picked (a click, 1-3,
             or Up/Down). Faithful comes first and is picked: it keeps the file as written. The
             key chip leads, as on the Cut target rows. -->
        <flex class="track-kind-list">
          <flex id="faithful-row" class="[track-kind-row,track-kind-row-selected]">
            <flex class="[key-chip,key-chip-on-card]">
              <label class="[key-chip-label,key-chip-label-on-quiet]" value="1"/>
            </flex>
            <label class="track-kind-icon" font="Lucide" value="&#xe2e0;"/>
            <label class="track-kind-name" value="Faithful track"/>
          </flex>
          <flex id="piano-roll-row" class="[track-kind-row,track-kind-row-idle]">
            <flex class="[key-chip,key-chip-on-card]">
              <label class="[key-chip-label,key-chip-label-on-quiet]" value="2"/>
            </flex>
            <label class="track-kind-icon" font="Lucide" value="&#xe560;"/>
            <label class="track-kind-name" value="Piano Roll track"/>
          </flex>
          <flex id="project-row" class="[track-kind-row,track-kind-row-idle]">
            <flex class="[key-chip,key-chip-on-card]">
              <label class="[key-chip-label,key-chip-label-on-quiet]" value="3"/>
            </flex>
            <label class="track-kind-icon" font="Lucide" value="&#xe529;"/>
            <label class="track-kind-name" value="Replace project"/>
          </flex>

          <panel class="track-kind-gap"/>

          <!-- What the file holds, where Add Track has its drop hint. Set by ImportDialog.cs. -->
          <flex class="track-kind-drop">
            <label class="track-kind-drop-icon" font="Lucide" value="&#xe0cc;"/>
            <flex class="track-kind-drop-text">
              <label id="count-label" class="track-kind-drop-label" value=""/>
              <label id="speed-label" class="track-kind-drop-label" value=""/>
            </flex>
          </flex>
        </flex>

        <!-- The picked way's card: what the import makes, three facts, and the name.
             ImportDialog.cs keeps one preview and one facts block in their slots. -->
        <flex class="track-kind-details">
          <panel id="preview-slot" class="track-kind-preview-slot"/>
          <flex id="facts-slot" class="track-kind-facts-slot"/>
          <panel class="track-field-row">
            <label class="[field-label,track-field-label]" value="Name"/>
            <text-input id="name-input" class="track-field-input"/>
          </panel>
        </flex>
      </flex>

      <!-- ImportDialog.cs puts the Esc and Enter chips on these, and names the action after
           the picked way. Replace swaps the blue fill for the red one, and light-label for
           dark-label. -->
      <flex class="dialog-actions">
        <button id="cancel-button" class="dialog-button">
          <label value="Cancel"/>
        </button>
        <button id="import-button" class="dialog-button-primary">
          <label class="light-label" value="Import as Faithful Track"/>
        </button>
      </flex>
    </flex>
  </layout>
</sundex>
