<sundex version="1.0">
  <style language="sundex" src="Scenes/Dialogs/Dialogs.snx.ss"/>

  <layout>
    <flex id="unsaved-changes-dialog" class="dialog-frame">
      <flex class="dialog-header">
        <label class="dialog-title" value="Save before leaving?"/>
        <panel class="spacer"/>
        <button id="close-button" class="icon-button">
          <label class="icon-button-icon" font="Lucide" value="&#xe1b2;"/>
        </button>
      </flex>

      <!-- The project being left. Its name and where it is saved are set by
           UnsavedChangesDialog.cs, and cut off at the card's edge when long. -->
      <flex class="project-card">
        <label class="project-card-icon" font="Lucide" value="&#xe55e;"/>
        <flex class="project-card-text">
          <clipped-label id="project-name" class="body-label"/>
          <clipped-label id="project-path" class="project-card-path"/>
        </flex>
      </flex>

      <!-- Discard stands alone at the left, so it is never the button next to Save. The
           Esc and Enter chips on Cancel and Save are added by UnsavedChangesDialog.cs. -->
      <flex class="dialog-actions-split">
        <button id="discard-button" class="dialog-button-danger-quiet">
          <label class="danger-label" value="Discard changes"/>
        </button>
        <panel class="spacer"/>
        <button id="cancel-button" class="dialog-button">
          <label value="Cancel"/>
        </button>
        <button id="save-button" class="dialog-button-primary">
          <label value="Save"/>
        </button>
      </flex>
    </flex>
  </layout>
</sundex>
