<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ThirtyDollarGUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="350"
        x:Class="ThirtyDollarGUI.Views.ExportSettings"
        x:DataType="vm:ExportSettingsViewModel"
        Title="Export Settings"
        Icon="/Assets/moai.png"
        MinHeight="560"
        MinWidth="400"
        Height="560"
        Width="400"

        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#31313A"
                    TintOpacity="1"
                    MaterialOpacity="0.60" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <StackPanel Margin="10">
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Sample Rate</TextBlock>
                <TextBox Text="{Binding SampleRateText}" />
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Channels</TextBlock>
                <ComboBox SelectedIndex="{Binding ChannelsIndex}">
                    <ComboBoxItem>Mono</ComboBoxItem>
                    <ComboBoxItem>Stereo</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Cut Volume Fade in Milliseconds</TextBlock>
                <TextBox Text="{Binding CutDelayText}" />
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Max Thread Slices Count</TextBlock>
                <TextBox Text="{Binding EncodeSlicesCountText}" />
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Resampler</TextBlock>
                <ComboBox SelectedItem="{Binding SelectedExportSettings}" ItemsSource="{Binding ListItems}"
                          MaxDropDownHeight="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <ComboBoxItem Content="{Binding ResamplerName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="10">
                <CheckBox IsChecked="{Binding EnableNormalization}">Enable Normalization</CheckBox>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Volume Scale</TextBlock>
                <ComboBox SelectedItem="{Binding VolumeScale}" ItemsSource="{Binding ScaleItems}" />
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock FontSize="11">Pan Scale</TextBlock>
                <ComboBox SelectedItem="{Binding PanScale}" ItemsSource="{Binding ScaleItems}" />
            </StackPanel>
        </StackPanel>
    </Panel>
</Window>