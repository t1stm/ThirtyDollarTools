<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22"/>
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8"/>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
    <PackageReference Include="Serilog" Version="4.4.0"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThirtyDollarConverter\ThirtyDollarConverter.csproj"/>
  </ItemGroup>

</Project>
