<sundex version="2.0">
  <style language="sundex" src="Markup/Counter.snx.ss"/>

  <logic language="csharp" src="Markup/Counter.snx.csx"/>

  <layout>
    <flex id="counter" class="counter" direction="vertical">
      <label ref="shown" class="count" class.odd="{count.Value % 2 == 1}" value="Count: {count.Value}"/>
      <label class="greeting" value="{Context.Greeting.Value}"/>
      <button class="increment" on.click="{Increment}">
        <label value="Add one"/>
      </button>
      <if condition="{count.Value == 0}">
        <label class="branch" value="none"/>
      </if>
      <else-if condition="{count.Value % 2 == 1}">
        <label class="branch" value="odd"/>
      </else-if>
      <else>
        <label class="branch" value="even"/>
      </else>
    </flex>
  </layout>
</sundex>
