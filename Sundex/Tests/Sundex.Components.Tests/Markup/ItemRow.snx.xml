<sundex version="2.0" component="item-row">
  <props>
    <prop name="name" type="string"/>
    <prop name="position" type="int" default="0"/>
  </props>

  <logic language="csharp" src="Markup/ItemRow.snx.csx"/>

  <layout>
    <flex class="row">
      <label class="row-name" value="{position}. {name}"/>
      <slot/>
    </flex>
  </layout>
</sundex>
