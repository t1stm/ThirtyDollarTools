<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sundex.Components.TestResources</RootNamespace>
    <!-- Markup 2.0: the documents under Markup/ are compiled by the generator. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <SundexMarkupNamespace>Sundex.Components.Tests.Markup</SundexMarkupNamespace>
    <SundexMarkupContext>Sundex.Components.Tests.Markup.TestAppContext</SundexMarkupContext>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sundex.Markup.Generator\Sundex.Markup.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\Sundex.Reactive\Sundex.Reactive.csproj"/>
    <AdditionalFiles Include="Markup/**/*.snx.xml;Markup/**/*.snx.csx;Markup/**/*.snx.ss"/>
    <EmbeddedResource Include="Markup/**/*.snx.ss"/>
    <CompilerVisibleProperty Include="RootNamespace;SundexMarkupNamespace;SundexMarkupContext"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sundex.Components\Sundex.Components.csproj"/>
    <ProjectReference Include="..\..\Sundex.Markup\Sundex.Markup.csproj"/>
    <ProjectReference Include="..\..\Sundex.Markup.Legacy\Sundex.Markup.Legacy.csproj"/>
    <ProjectReference Include="..\..\Sundex.Testing\Sundex.Testing.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
    <PackageReference Include="Serilog" Version="4.4.0"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Sundex.Testing"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Layouts/**/*.xml"/>
    <EmbeddedResource Include="Layouts/**/*.txt"/>
    <EmbeddedResource Include="Assets/**/*.png"/>
    <EmbeddedResource Include="Assets/Markdown/*.md"/>
  </ItemGroup>

</Project>
