<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13"/>
    <PackageReference Include="OpenTK" Version="5.0.0-pre.16"/>
    <PackageReference Include="OpenTK.redist.glfw" Version="3.5.1.71"/>
    <PackageReference Include="Serilog" Version="4.4.0"/>
    <PackageReference Include="Serilog.Expressions" Version="5.0.0"/>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundex.Slug\Sundex.Slug.csproj"/>
    <ProjectReference Include="..\Sundex.Reactive\Sundex.Reactive.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Lato-Bold.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\Lato-Regular.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\lucide.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\README.md"/>
    <None Update="Assets/Fonts/LICENSE-*.txt" Pack="true" PackagePath="licenses/"/>
    <None Update="buildTransitive/Sundex.Engine.props" Pack="true" PackagePath="buildTransitive/"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.frag"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.vert"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\"/>
  </ItemGroup>

</Project>
