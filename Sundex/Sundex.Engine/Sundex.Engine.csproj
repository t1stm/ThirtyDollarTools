<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4"/>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8"/>
    <PackageReference Include="OpenTK" Version="5.0.0-pre.15"/>
    <PackageReference Include="OpenTK.redist.glfw" Version="3.4.0.47"/>
    <PackageReference Include="Serilog" Version="4.3.1"/>
    <PackageReference Include="Serilog.Expressions" Version="5.1.0-dev-02309"/>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundex.MSDF\Sundex.MSDF.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Lato-Bold.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\Lato-Regular.ttf"/>
    <EmbeddedResource Include="Assets\Fonts\README.md"/>
    <EmbeddedResource Include="Assets\Fonts\Twemoji.Mozilla.ttf"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.frag"/>
    <EmbeddedResource Include="Assets\Shaders\Text\Batched.vert"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\"/>
  </ItemGroup>

