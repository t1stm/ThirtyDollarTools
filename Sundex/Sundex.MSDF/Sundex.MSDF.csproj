<Project Sdk="Microsoft.NET.Sdk">

  <!-- The distance-field algorithms here follow Chlumsky/msdfgen (MIT). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.Fonts" Version="3.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sundex.MSDF.Tests"/>
  </ItemGroup>

</Project>
